rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profileData(userId) {
      return get(/databases/$(database)/documents/profiles/$(userId)).data;
    }

    function hasClaim(userId) {
      return exists(/databases/$(database)/documents/profiles/$(userId))
        && 'playerId' in profileData(userId)
        && profileData(userId).playerId != null;
    }

    function claimOwner(playerId) {
      return exists(/databases/$(database)/documents/claims/$(playerId))
        ? get(/databases/$(database)/documents/claims/$(playerId)).data.uid
        : null;
    }

    function validName(d) {
      return d.displayName is string
        && d.displayName.size() >= 2
        && d.displayName.size() <= 40;
    }

    // One document per claimed player. Create-only, so Firestore itself
    // guarantees that two people can never hold the same identity: the
    // second create lands on an existing document and is refused.
    match /claims/{playerId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /profiles/{userId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == userId
        && validName(request.resource.data);

      // playerId is write-once, and may only be set to a player whose claim
      // document you already hold. Together those stop both identity
      // switching and impersonating someone else.
      allow update: if signedIn()
        && request.auth.uid == userId
        && validName(request.resource.data)
        && (
          (
            'playerId' in resource.data
            && resource.data.playerId != null
            && 'playerId' in request.resource.data
            && request.resource.data.playerId == resource.data.playerId
          )
          || (
            (!('playerId' in resource.data) || resource.data.playerId == null)
            && (
              !('playerId' in request.resource.data)
              || request.resource.data.playerId == null
              || claimOwner(request.resource.data.playerId) == request.auth.uid
            )
          )
        );
    }

    match /players/{playerId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.position in ['GK', 'DEF', 'MID', 'FWD'];
      allow delete: if signedIn();
    }

    match /matches/{matchId} {
      allow read, write: if signedIn();

      // You must have said who you are before you may rate at all, and you
      // may never appear on your own card.
      match /votes/{userId} {
        allow read: if signedIn();

        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.voterName is string
          && request.resource.data.scores is map
          && hasClaim(userId)
          && !(profileData(userId).playerId in request.resource.data.scores.keys());

        allow delete: if false;
      }
    }
  }
}
