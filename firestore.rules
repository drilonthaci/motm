rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40;
    }

    // Shared roster of colleagues. Anyone signed in can maintain it, same
    // trust model as matches, we just check the shape so a bad client
    // cannot write a roster entry the UI chokes on.
    match /players/{playerId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.position in ['GK', 'DEF', 'MID', 'FWD'];
      allow delete: if request.auth != null;
    }

    match /matches/{matchId} {
      allow read, write: if request.auth != null;

      // One rating card per person, and only your own.
      match /votes/{userId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.voterName is string;
        allow delete: if false;
      }
    }
  }
}
